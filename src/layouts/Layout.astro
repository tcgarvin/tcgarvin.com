---
import Header, { type Props as HeaderProps } from "../components/Header.astro";

export interface Props {
  pageTitle: string;
  description?: string;
  header?: HeaderProps;
}

const { pageTitle, description, header = {} } = Astro.props;
const iconSizes = [48, 72, 96, 144, 192, 256, 384, 512];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle} - tcgarvin.com</title>
    {description && <meta name="description" content={description} />}
    {/*
      Frozen compiled output of the original Gatsby build (Bootstrap 3.3.7 via
      bootstrap-styl, plus the site's own styles). Kept verbatim so the design
      is pixel-identical; edit it directly for style changes.
    */}
    <link rel="stylesheet" href="/css/tcgarvin.css" />
    <link rel="icon" href="/icons/icon-48x48.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#663399" />
    {
      iconSizes.map((size) => (
        <link rel="apple-touch-icon" sizes={`${size}x${size}`} href={`/icons/icon-${size}x${size}.png`} />
      ))
    }
  </head>
  <body>
    <Header {...header} />
    <slot />
    <script>
      // The old Gatsby site installed an offline service worker; make sure any
      // lingering registration is removed so visitors get the live site.
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          for (const registration of registrations) registration.unregister();
        });
      }
    </script>
  </body>
</html>
